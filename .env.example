# Copy this file to frontend/.env to override local dev defaults. Only used by `npm run dev`
# (the Vite dev server) - the production Docker build is served by nginx, which proxies /api to
# the backend container via frontend/nginx.conf instead, so these vars don't apply there.

# Where the Vite dev server's /api proxy forwards requests. Defaults to http://localhost:8080
# (a backend run with `mvn spring-boot:run` or `docker compose up backend`) if unset.
VITE_API_PROXY_TARGET=http://localhost:8080
